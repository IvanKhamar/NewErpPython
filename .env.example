# Copy this file to .env (same folder) and put your real values there.
# .env is in .gitignore, so it never reaches GitHub. Real env vars win over .env.

# MySQL from docker-compose (port 3307, so it does not clash with the local MySQL80 on 3306).
NEWERP_DB_HOST=localhost
NEWERP_DB_PORT=3307
NEWERP_DB_NAME=newerp_dev
NEWERP_DB_USER=newerp
NEWERP_DB_PASSWORD=newerp_dev_password

# To share the database with the .NET and Java versions, point it at the local MySQL80 instead:
#NEWERP_DB_PORT=3306
#NEWERP_DB_PASSWORD=put_your_password_here

NEWERP_REDIS_URL=redis://localhost:6379/0

# Kafka from docker-compose for order events; without it the events are only logged.
#NEWERP_KAFKA__BOOTSTRAP_SERVERS=localhost:9092

# Low-stock alert: an SMS at 08:00 about consumables that fell below their minimum (a JSON list of phones).
#NEWERP_STOCK__ALERT_PHONES=["+380000000000"]

# Log in as a customer: the storefront address and how long the one-time link works (minutes).
# NEWERP_CUSTOMERS__STORE_URL=https://shop.example/
# NEWERP_CUSTOMERS__LOGIN_LINK_MINUTES=5

# monobank acquiring (plata by mono): the merchant token; without it test invoices nobody can pay.
# NEWERP_MONOBANK__TOKEN=
# NEWERP_MONOBANK__REDIRECT_URL=https://shop.example/

# E-mail (gift vouchers): SMTP; without a host nothing is sent.
# NEWERP_MAIL__HOST=smtp.example.com
# NEWERP_MAIL__PORT=587
# NEWERP_MAIL__USERNAME=
# NEWERP_MAIL__PASSWORD=
# NEWERP_MAIL__FROM_ADDRESS=shop@example.com

# TikTok catalog feed (/feeds/tiktok.csv): its token; without it the feed is off.
# NEWERP_TIKTOK_FEED__TOKEN=
# Instagram block: the storefront image folder if the ERP can write it, and how often to look for new posts.
# NEWERP_INSTAGRAM__IMAGE_DIR=
# NEWERP_INSTAGRAM__UPDATE_INTERVAL_HOURS=6

# Admin tools: OpenCart files the ERP can reach on a shared volume (empty: that tool is off).
# NEWERP_ADMIN_TOOLS__ERROR_LOG=/var/www/storage/logs/error.log
# NEWERP_ADMIN_TOOLS__UPLOAD_DIR=/var/www/storage/upload
